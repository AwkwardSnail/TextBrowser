<Window x:Class="TextBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBrowser" Width="1040" Height="760" MinWidth="560" MinHeight="360"
        Background="#1c1c1c" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="16">

  <Window.Resources>
    <!-- Phosphor colours; replaced at runtime when the theme changes (F2). -->
    <SolidColorBrush x:Key="Bg" Color="#020a02"/>
    <SolidColorBrush x:Key="Fg" Color="#33ff66"/>
    <SolidColorBrush x:Key="Bright" Color="#b6ffc8"/>
    <SolidColorBrush x:Key="Dim" Color="#1f9940"/>

    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Bright}"/>
      <Setter Property="TextDecorations" Value="Underline"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <!-- Inverse video for the link under the mouse or keyboard focus. -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Fg}"/>
          <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource Fg}"/>
          <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- One dark line every 3 pixels. -->
    <DrawingBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,1,3" ViewportUnits="Absolute"
                  Viewbox="0,0,1,3" ViewboxUnits="Absolute" Stretch="Fill">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#00000000" Geometry="M0,0 H1 V2 H0 Z"/>
          <GeometryDrawing Brush="#000000" Geometry="M0,2 H1 V3 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>

  <!-- The monitor: a dark bezel around a rounded phosphor screen. -->
  <Border Margin="18" CornerRadius="16" Background="{DynamicResource Bg}"
          BorderBrush="#2b2b2b" BorderThickness="3">
    <Grid>
      <Grid x:Name="Screen" Margin="18,14">
        <Grid.Effect>
          <DropShadowEffect ShadowDepth="0" BlurRadius="9" Opacity="0.55" Color="#33ff66"/>
        </Grid.Effect>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Fg}" Padding="8,2">
          <TextBlock x:Name="HeaderText" Foreground="{DynamicResource Bg}" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="URL&gt;" FontWeight="Bold" Foreground="{DynamicResource Fg}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <!-- Block cursor drawn behind the transparent text box, like a terminal. -->
          <Canvas Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle x:Name="BlockCaret" Fill="{DynamicResource Fg}" Visibility="Collapsed"/>
          </Canvas>
          <TextBox x:Name="UrlBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource Bright}" CaretBrush="Transparent"
                   SelectionBrush="{DynamicResource Fg}" SelectionOpacity="0.5"
                   Padding="0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"/>
        </Grid>

        <Border Grid.Row="2" Height="1" Background="{DynamicResource Dim}" Margin="0,0,0,6"/>

        <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="3" IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  SelectionBrush="{DynamicResource Fg}"
                                  FocusVisualStyle="{x:Null}"
                                  KeyboardNavigation.TabNavigation="Cycle"/>

        <Border Grid.Row="4" Background="{DynamicResource Fg}" Padding="8,2" Margin="0,8,0,0">
          <DockPanel>
            <TextBlock x:Name="ScrollText" DockPanel.Dock="Right" Foreground="{DynamicResource Bg}"
                       MinWidth="48" TextAlignment="Right"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Bg}"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- CRT effects (F3): scanlines and darkened corners. -->
      <Rectangle x:Name="ScanlineLayer" Fill="{StaticResource Scanlines}" Opacity="0.22"
                 RadiusX="13" RadiusY="13" IsHitTestVisible="False"/>
      <Rectangle x:Name="VignetteLayer" RadiusX="13" RadiusY="13" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#00000000" Offset="0.62"/>
            <GradientStop Color="#99000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
  </Border>
</Window>
