<Window x:Class="TextBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBrowser" Icon="Packaging/Assets/TextBrowser.ico" Width="1040" Height="760" MinWidth="560" MinHeight="360"
        Background="#1c1c1c" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="16">

  <Window.Resources>
    <!-- Phosphor colours; replaced at runtime when the theme changes (F2). -->
    <SolidColorBrush x:Key="Bg" Color="#020a02"/>
    <SolidColorBrush x:Key="Fg" Color="#33ff66"/>
    <SolidColorBrush x:Key="Bright" Color="#b6ffc8"/>
    <SolidColorBrush x:Key="Dim" Color="#1f9940"/>

    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource Bright}"/>
      <Setter Property="TextDecorations" Value="Underline"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <!-- Inverse video for the link under the mouse or keyboard focus. -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Fg}"/>
          <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource Fg}"/>
          <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Form fields on pages: an underlined input line that brightens when focused. -->
    <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
      <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Dim}"
              BorderThickness="0,0,0,1" Padding="2,0">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fg}"/>
          <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Bright}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
    </Style>
    <Style x:Key="FieldPassword" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{DynamicResource Bright}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
    </Style>

    <!-- Drop-down menus: a boxed choice with a phosphor list underneath. -->
    <Style x:Key="FieldCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Bright}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Dim}" BorderThickness="1">
              <Grid>
                <ToggleButton Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent"/>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <DockPanel Margin="6,0,4,0" IsHitTestVisible="False">
                  <TextBlock DockPanel.Dock="Right" Text=" &#x25BC;" Foreground="{TemplateBinding Foreground}"/>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                </DockPanel>
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="None">
                  <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Fg}" BorderThickness="1"
                          MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Item" Background="Transparent" Padding="6,1">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Item" Property="Background" Value="{DynamicResource Fg}"/>
                      <Setter Property="Foreground" Value="{DynamicResource Bg}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- The monitor: a dark bezel around a rounded phosphor screen. -->
  <Border Margin="18" CornerRadius="16" Background="{DynamicResource Bg}"
          BorderBrush="#2b2b2b" BorderThickness="3">
    <Grid>
      <Grid x:Name="Screen" Margin="18,14">
        <Grid.Effect>
          <DropShadowEffect ShadowDepth="0" BlurRadius="9" Opacity="0.55" Color="#33ff66"/>
        </Grid.Effect>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Fg}" Padding="8,2">
          <TextBlock x:Name="HeaderText" Foreground="{DynamicResource Bg}" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="URL&gt;" FontWeight="Bold" Foreground="{DynamicResource Fg}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <!-- Block cursor drawn behind the transparent text box, like a terminal. -->
          <Canvas Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle x:Name="BlockCaret" Fill="{DynamicResource Fg}" Visibility="Collapsed"/>
          </Canvas>
          <TextBox x:Name="UrlBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource Bright}" CaretBrush="Transparent"
                   SelectionBrush="{DynamicResource Fg}" SelectionOpacity="0.5"
                   Padding="0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"/>
        </Grid>

        <Border Grid.Row="2" Height="1" Background="{DynamicResource Dim}" Margin="0,0,0,6"/>

        <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="3" IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  SelectionBrush="{DynamicResource Fg}"
                                  FocusVisualStyle="{x:Null}"
                                  KeyboardNavigation.TabNavigation="Cycle"/>

        <Border Grid.Row="4" Background="{DynamicResource Fg}" Padding="8,2" Margin="0,8,0,0">
          <DockPanel>
            <TextBlock x:Name="ScrollText" DockPanel.Dock="Right" Foreground="{DynamicResource Bg}"
                       MinWidth="48" TextAlignment="Right"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Bg}"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- CRT effect (F3, with the glow): darkened corners. -->
      <Rectangle x:Name="VignetteLayer" RadiusX="13" RadiusY="13" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#00000000" Offset="0.62"/>
            <GradientStop Color="#99000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
  </Border>
</Window>
