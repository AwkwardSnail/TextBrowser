<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TextBrowser</RootNamespace>
    <AssemblyName>TextBrowser</AssemblyName>
    <Product>TextBrowser</Product>
    <Company>Awkward Snail</Company>
    <Version>2.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Packaging\Assets\TextBrowser.ico</ApplicationIcon>
    <!-- The app is English only; leave out .NET's translated messages so the
         Store doesn't list languages TextBrowser doesn't support. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaging scripts are tools, not part of the app. -->
    <Compile Remove="Packaging\**;dist\**" />
    <None Remove="dist\**" />
    <Resource Include="Packaging\Assets\TextBrowser.ico" />
    <EmbeddedResource Include="Extract.js" LogicalName="Extract.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
